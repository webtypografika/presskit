{
  "name": "presskit",
  "version": "2.3.9",
  "description": "PressKit - Print & Design File Manager",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "set NODE_OPTIONS=--max-old-space-size=8192&& electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "package": "electron-vite build && electron-builder",
    "release": "electron-vite build && electron-builder --publish always",
    "postinstall": "electron-builder install-app-deps"
  },
  "dependencies": {
    "adm-zip": "^0.5.17",
    "ag-psd": "^30.1.0",
    "better-sqlite3": "^12.8.0",
    "chokidar": "^5.0.0",
    "dropbox": "^10.34.0",
    "electron-store": "^10.0.0",
    "electron-updater": "^6.8.3",
    "exifreader": "^4.23.0",
    "nodemailer": "^8.0.5",
    "opentype.js": "^1.3.4",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^4.9.155",
    "sharp": "^0.33.5"
  },
  "devDependencies": {
    "@electron-toolkit/preload": "^3.0.1",
    "@electron-toolkit/utils": "^3.0.0",
    "@tailwindcss/vite": "^4.1.0",
    "@tanstack/react-query": "^5.95.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.0.0",
    "@types/nodemailer": "^8.0.0",
    "@types/opentype.js": "^1.3.8",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.5.0",
    "clsx": "^2.1.1",
    "electron": "^33.3.0",
    "electron-builder": "^25.1.0",
    "electron-vite": "^3.0.0",
    "lucide-react": "^1.0.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.7.0",
    "vite": "^6.3.0",
    "zustand": "^5.0.12"
  },
  "build": {
    "appId": "com.presscal.presskit",
    "productName": "PressKit",
    "copyright": "Copyright © 2026 PressCal",
    "directories": {
      "buildResources": "resources",
      "output": "dist"
    },
    "files": [
      "out/**/*",
      "resources/**/*"
    ],
    "asarUnpack": [
      "node_modules/better-sqlite3/**",
      "node_modules/sharp/**",
      "node_modules/@img/**"
    ],
    "extraResources": [
      {
        "from": "resources/icon.ico",
        "to": "icon.ico"
      },
      {
        "from": "vendor/Everything",
        "to": "Everything",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "resources/icon.ico",
      "artifactName": "PressKit-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "PressKit",
      "installerIcon": "resources/icon.ico",
      "uninstallerIcon": "resources/icon.ico",
      "include": "resources/installer.nsh"
    },
    "publish": {
      "provider": "github",
      "owner": "webtypografika",
      "repo": "presskit"
    },
    "protocols": {
      "name": "PressCal File Helper",
      "schemes": [
        "presscal-fh"
      ]
    }
  }
}
